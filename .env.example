# Direct binary configuration. Copy this file to .env or export variables;
# never commit a real .env file.

# postgres (default) or sqlite
TICKETHUB_DB_DRIVER=postgres

# PostgreSQL connection string. Prefer a .pgpass file over embedding a password.
TICKETHUB_DATABASE_URL=host=127.0.0.1 port=5432 dbname=tickethub user=tickethub

# Used only when TICKETHUB_DB_DRIVER=sqlite
TICKETHUB_SQLITE_PATH=./ticket-hub.db

TICKETHUB_BIND_ADDRESS=127.0.0.1
TICKETHUB_PORT=8080
TICKETHUB_AUTO_MIGRATE=true

# Demo data ships a global administrator (demo@ticket-hub.local) whose
# password is published in migrations/*/002_seed_demo.sql. Leave this false
# for anything reachable from outside this machine -- Ticket Hub refuses to
# start if it is true while TICKETHUB_BIND_ADDRESS is not a loopback address.
TICKETHUB_SEED_DEMO=false

# Optional overrides. Defaults point into the source tree for local development.
# TICKETHUB_WEB_ROOT=/opt/ticket-hub/share/web
# TICKETHUB_MIGRATIONS_ROOT=/opt/ticket-hub/share/migrations

# Production Docker Compose configuration. These values are consumed by
# docker-compose.yml; replace the password before first use.
TICKETHUB_POSTGRES_DB=tickethub
TICKETHUB_POSTGRES_USER=tickethub
TICKETHUB_POSTGRES_PASSWORD=replace-with-a-long-random-secret
TICKETHUB_HTTP_PORT=8080

# Optional SMTP configuration for the outbox worker.
# TICKETHUB_SMTP_HOST=smtp.example.com
# TICKETHUB_SMTP_PORT=587
# TICKETHUB_SMTP_USERNAME=ticket-hub
# TICKETHUB_SMTP_PASSWORD=replace-with-an-smtp-secret
# TICKETHUB_SMTP_FROM=tickets@example.com
